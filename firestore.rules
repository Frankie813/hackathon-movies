rules_version = '2';

// Everything is closed except what the demo path needs, and every rule requires
// an anonymous-auth user (#2). Issue #16 settled the sessions/{code} shape and
// replaced the blanket session rules below with per-document ownership.
//
//   sessions/{code}                { code, hostUid, createdAt }
//   sessions/{code}/members/{uid}  { likes[], dislikes[], joinedAt, name? }
//   sessions/{code}/match/current  { tmdbId, sessionCode, matchedAt, why? } (#17)
//   users/{uid}/matches/{code}-{tmdbId}  the same verdict, for #41's Saved tab
//   users/{uid}/taste/current      { vector, updatedAt } (#18)
//   users/{uid}/likes/{movieId}    { movieId, likedAt } (#18)
//   users/{uid}/watchlist/{movieId} { movieId, addedAt } (#87)
//
// Join codes are guessable by design — four letters is the point — so the
// protection that matters is that nobody can rewrite somebody else's swipes or
// take over a session, not that the session is secret.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function inSession(code, uid) {
      return exists(/databases/$(database)/documents/sessions/$(code)/members/$(uid));
    }

    // Codes are guessable by design — four letters is the point — so "is this
    // caller actually in the session" is the check that carries the weight.
    // Costs one document read per evaluation; sessions are tiny and rare.
    function isMember(code) {
      return signedIn() && inSession(code, request.auth.uid);
    }

    // Group sessions, keyed by the 4-letter join code.
    match /sessions/{code} {
      allow read: if signedIn();
      // The creator must name themselves as the host, and the document has to
      // agree with the path it lives at.
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code == code;
      // Fields can be added (#17 may record the group's verdict here), but only
      // by someone in the session, and the host and code are frozen once it
      // exists. createSession() is unaffected — it creates, then joins.
      allow update: if isMember(code)
                    && request.resource.data.hostUid == resource.data.hostUid
                    && request.resource.data.code == resource.data.code;
      allow delete: if false;

      // One document per anonymous uid. Anyone in the session can read the
      // member list — #17 needs every member's likes to rank the group — but
      // only the owner writes their own swipes.
      match /members/{memberUid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == memberUid;
      }

      // The group's match (#17) — the verdict the reveal screen (#10) puts in
      // front of judges. Any member may write it; whoever's device detects the
      // match first wins and the rest react to the document. Nobody outside
      // the session gets to write what the group is watching.
      match /match/{docId} {
        allow read: if signedIn();
        allow create, update: if isMember(code);
        allow delete: if false;
      }
    }

    // A member's own saved matches (#17), read by #41's Saved tab.
    //
    // The device that detects the match writes the row for *everyone* in the
    // group, so this is the one place a user writes into another user's
    // document. It is narrow: the row has to name a session, and both the
    // writer and the owner of the document have to be members of it. A
    // stranger who guesses a uid still cannot put anything here.
    match /users/{uid}/matches/{matchId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
                            && request.resource.data.sessionCode is string
                            && inSession(request.resource.data.sessionCode, request.auth.uid)
                            && inSession(request.resource.data.sessionCode, uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A user's own taste vector and like list (#18). Strictly private: unlike
    // matches above, nothing in the group flow needs another device to read or
    // write these, so the owner is the only one who touches them.
    match /users/{uid}/taste/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/likes/{movieId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // The titles the user explicitly saved for later (#87) — the only thing
    // the Saved tab shows apart from group matches. Private like the two above.
    match /users/{uid}/watchlist/{movieId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Read-only probe used by checkFirestoreReachable(). The document does not
    // need to exist — the read resolving is the signal.
    match /health/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
