# Copy to .env and fill in. .env is gitignored — never commit real values.
# Agents are blocked from reading .env by .claude/settings.json.

# ─── Client-safe (ships in the app bundle; these are NOT secrets) ───────────
# Firebase web config — public by design, protected by Firestore rules + App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The .tech domain, used to build join links / QR codes (issues #19, #32, #33).
EXPO_PUBLIC_JOIN_BASE_URL=https://yourname.tech

# TMDB v4 read-access token, for the app itself (issue #15). Read-only,
# non-commercial, free-tier and rate-limited by IP. Expo inlines only
# EXPO_PUBLIC_* into the bundle, and this project has no server-side component
# to hide a token behind (Spark plan, no Cloud Functions, no proxy), so the
# catalog layer in lib/tmdb.ts reads it from here.
#
# NOTE: this is in tension with issue #3 below, whose scripts/scan-client-secrets.mjs
# asserts that no TMDB token appears in a built bundle. Filling this in with the
# same value as TMDB_READ_ACCESS_TOKEN will make that scan report a leak. See PR #60.
# Leave it blank to run the app seed-only.
EXPO_PUBLIC_TMDB_READ_TOKEN=

# ─── Local tooling (never ships in the app bundle) ─────────────────────────
# TMDB: API Read Access Token (v4 bearer). Non-commercial use only.
# Attribution is mandatory on the About screen — see issue #27.
# TMDB_BEARER is issue #3's contract name; TMDB_READ_ACCESS_TOKEN is the name the
# #4 curation script already reads. Both hold the same v4 token, and the issue #3
# scripts accept either, so filling in one is enough.
TMDB_BEARER=
TMDB_READ_ACCESS_TOKEN=
# v3 key — fallback for scripts/curate.mjs only.
TMDB_API_KEY=

# ─── Tooling ───────────────────────────────────────────────────────────────
# Optional. For scripts/create-issues.mjs and for GitHub MCP under Codex.
# Claude Code can instead authenticate GitHub MCP via OAuth (`/mcp`).
GITHUB_TOKEN=
