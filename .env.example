# Copy to .env and fill in. .env is gitignored — never commit real values.
# Agents are blocked from reading .env by .claude/settings.json.

# ─── Client-safe (ships in the app bundle; these are NOT secrets) ───────────
# Firebase web config — public by design, protected by Firestore rules + App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The .tech domain, used to build join links / QR codes (issues #19, #32, #33).
EXPO_PUBLIC_JOIN_BASE_URL=https://yourname.tech

# ─── Local tooling (never ships in the app bundle) ─────────────────────────
# TMDB: API Read Access Token (v4 bearer). Non-commercial use only.
# Attribution is mandatory on the About screen — see issue #27.
TMDB_BEARER=
# Existing issue #4 curation script uses these names. For curation, put the
# same read bearer in TMDB_READ_ACCESS_TOKEN (or use the v3 key as a fallback).
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# ─── Tooling ───────────────────────────────────────────────────────────────
# Optional. For scripts/create-issues.mjs and for GitHub MCP under Codex.
# Claude Code can instead authenticate GitHub MCP via OAuth (`/mcp`).
GITHUB_TOKEN=
