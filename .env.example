# Copy to .env and fill in. .env is gitignored — never commit real values.
# Agents are blocked from reading .env by .claude/settings.json.

# ─── Client-safe (ships in the app bundle; these are NOT secrets) ───────────
# Firebase web config — public by design, protected by Firestore rules + App Check.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The .tech domain, used to build join links / QR codes (issues #19, #32, #33).
EXPO_PUBLIC_JOIN_BASE_URL=https://yourname.tech

# TMDB v4 read-access token. Read-only, non-commercial, free-tier, rate-limited
# by IP. It ships in the bundle on purpose: this project has no server-side
# component to hide it behind (Spark plan, no Cloud Functions, no proxy — see
# AGENTS.md §3), and the catalog layer in lib/tmdb.ts needs it on device.
# This is the ONLY EXPO_PUBLIC_ secret-ish value the scan hook allows.
# Attribution is mandatory on the About screen — see issue #27.
EXPO_PUBLIC_TMDB_READ_TOKEN=

# ─── Server-only (Cloud Function / proxy env — MUST NOT reach the client) ───
# TMDB, for scripts/curate.mjs only (Node, never bundled). Same credential as
# EXPO_PUBLIC_TMDB_READ_TOKEN above; kept separate so the curation script keeps
# working unchanged and so the v3 key never leaks into the client.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# ElevenLabs: lives only in the `tts` Cloud Function / Express proxy (issue #34).
# If this string ever appears in an EXPO_PUBLIC_* var or in app source, the
# secret-scan hook will block the write.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Gemini: preferred path is Firebase AI Logic, which keeps the key server-side
# and needs no value here. This is only for local scripts (curation, pre-gen).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── Tooling ───────────────────────────────────────────────────────────────
# Optional. For scripts/create-issues.mjs and for GitHub MCP under Codex.
# Claude Code can instead authenticate GitHub MCP via OAuth (`/mcp`).
GITHUB_TOKEN=
